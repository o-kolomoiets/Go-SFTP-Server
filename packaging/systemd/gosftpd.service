# gosftpd as a systemd service (ADR 0011). Do not edit this file: change
# it with a drop-in (systemctl edit gosftpd), which an upgrade keeps. The
# install guide covers another data path, mounts under /home, port 22 and
# systemd before 253: https://github.com/o-kolomoiets/go-sftp-server/blob/main/docs/install.md
[Unit]
Description=gosftpd SFTP server
Documentation=https://github.com/o-kolomoiets/go-sftp-server/blob/main/docs/install.md
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/sftp
# At most 5 starts a minute, so that a failure that a restart does not fix
# stops the unit instead of restarting it forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Needs systemd 253 (EL9: 252-21); older versions need legacy-notify.conf.
Type=notify-reload
ExecStart=/usr/bin/gosftpd serve --config /etc/gosftpd/config.toml
User=gosftpd
Group=gosftpd
# /var/lib/gosftpd holds the host keys, /var/log/gosftpd the audit log.
StateDirectory=gosftpd
StateDirectoryMode=0700
LogsDirectory=gosftpd
LogsDirectoryMode=0750
# The data. "-": a missing directory is skipped instead of failing the
# start; systemd-tmpfiles creates it (gosftpd.tmpfiles).
ReadWritePaths=-/srv/sftp
UMask=0027
Restart=on-failure
RestartSec=2s
# Exit status 2 is a configuration or file system error, also a mount that
# cannot be opened: a restart does not fix it.
RestartPreventExitStatus=2
# At least server.shutdown_timeout + 10 s; at stop gosftpd extends it when
# a reload raised shutdown_timeout (EXTEND_TIMEOUT_USEC).
TimeoutStopSec=45
# SIGTERM to gosftpd only: running exec hooks finish during the drain, and
# whatever is left gets SIGKILL after gosftpd exits (ADR 0010).
KillMode=mixed
LimitNOFILE=131072
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX for sd_notify and journald.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Landlock, by name: @sandbox exists only from systemd 254.
SystemCallFilter=landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
